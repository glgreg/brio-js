{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "paths": { "/engine/brio.js": ["./node_modules/.brio-types/index.d.ts"] }
    },
    "include": ["src/**/*.ts"]
}
