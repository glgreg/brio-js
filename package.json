{
    "name": "brio-js",
    "version": "0.0.1",
    "type": "module",
    "sideEffects": false,
    "description": "Zero-dependency 2D and 3D web game engine in TypeScript with an OOP API over a data-oriented ECS core",
    "main": "dist/index.js",
    "scripts": {
        "build:win": "cls & tsc & npx ts-add-js-extension --dir=dist",
        "build:lin": "clear; rm -rf ./dist/; tsc; npx ts-add-js-extension --dir=dist",
        "doc": "npx typedoc --out docs/api",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GustavoLGregorio/brio-js.git"
    },
    "keywords": [
        "JavaScript",
        "TypeScript",
        "Game-Engine",
        "2D",
        "3D",
        "ECS",
        "Canvas",
        "Object-Oriented"
    ],
    "author": "Gustavo L. Gregorio",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/GustavoLGregorio/brio-js/issues"
    },
    "homepage": "https://github.com/GustavoLGregorio/brio-js#readme",
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.5.3",
        "ts-add-js-extension": "^1.6.6",
        "typedoc": "^0.28.17",
        "typescript": "^5.8.3",
        "vitest": "^5.0.5"
    },
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    }
}
