{
    "name": "@brio-js/core",
    "version": "0.1.0",
    "description": "Zero-dependency 2D and 3D web game engine in TypeScript: an approachable object-oriented API over a data-oriented ECS core, with WebGL2 rendering, Canvas2D fallback, Web Audio, scenes, and binary save states.",
    "keywords": [
        "game-engine",
        "gamedev",
        "game-development",
        "2d",
        "3d",
        "webgl",
        "webgl2",
        "canvas",
        "ecs",
        "entity-component-system",
        "typescript",
        "web-audio",
        "gltf",
        "browser-game",
        "zero-dependency",
        "education"
    ],
    "homepage": "https://github.com/glgreg/brio-js#readme",
    "bugs": {
        "url": "https://github.com/glgreg/brio-js/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/glgreg/brio-js.git"
    },
    "license": "MIT",
    "author": {
        "name": "Gustavo L. Gregorio",
        "url": "https://github.com/glgreg"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.txt",
        "GLOSSARY.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && ts-add-js-extension --dir=dist",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm test && npm run build",
        "doc": "typedoc --out docs/api",
        "prepack": "npm run build",
        "prepublishOnly": "npm run typecheck && npm test"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.5.3",
        "ts-add-js-extension": "^1.6.6",
        "typedoc": "^0.28.17",
        "typescript": "^5.8.3",
        "vitest": "^5.0.5"
    }
}
